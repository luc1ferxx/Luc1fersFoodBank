{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node"],
    "noEmit": true,
    // vite.config.ts imports src/api/proxyPaths.ts with its extension, as Vite's
    // native config loader requires.
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    // The build scripts stay plain JavaScript (CI runs them with Node 20, which cannot
    // execute TypeScript) and are type-checked through their JSDoc annotations.
    "allowJs": true,
    "checkJs": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["vite.config.ts", "scripts", "src/cspBuild.test.ts"]
}
