{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onlineorder.example/event-schemas/delivery-events/delivery.assigned/v1.json",
  "title": "delivery.assigned, version 1",
  "description": "Dispatch assigned a rider to the order's delivery. Topic delivery-events, record key: the order id, aggregate: DELIVERY (aggregate_id = the delivery id).",
  "$ref": "../../common/envelope/v1.json",
  "properties": {
    "event_type": {
      "const": "delivery.assigned"
    },
    "aggregate_type": {
      "const": "DELIVERY"
    },
    "data": {
      "$ref": "../../common/delivery-data/v1.json",
      "properties": {
        "status": {
          "const": "ASSIGNED"
        }
      }
    }
  }
}
