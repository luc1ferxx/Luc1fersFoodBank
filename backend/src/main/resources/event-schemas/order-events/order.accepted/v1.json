{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onlineorder.example/event-schemas/order-events/order.accepted/v1.json",
  "title": "order.accepted, version 1",
  "description": "A merchant accepted the order. Dispatch assigns a rider from it. Topic order-events, record key: the order id, aggregate: ORDER (aggregate_id = the order id).",
