  "properties": {
    "event_type": {
      "const": "order.accepted"
    },
    "aggregate_type": {
      "const": "ORDER"
    },
    "data": {
      "$ref": "../../common/order-data/v1.json",
      "properties": {
        "status": {
          "const": "ACCEPTED"
        }
      }
    }
  }
}
