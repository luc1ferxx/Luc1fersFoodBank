{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onlineorder.example/event-schemas/order-events/order.completed/v1.json",
  "title": "order.completed, version 1",
  "description": "The order was completed (delivered). Topic order-events, record key: the order id, aggregate: ORDER (aggregate_id = the order id).",
  "$ref": "../../common/envelope/v1.json",
  "properties": {
    "event_type": {
      "const": "order.completed"
    },
    "aggregate_type": {
      "const": "ORDER"
    },
    "data": {
      "$ref": "../../common/order-data/v1.json",
      "properties": {
        "status": {
          "const": "COMPLETED"
        }
      }
    }
  }
}
