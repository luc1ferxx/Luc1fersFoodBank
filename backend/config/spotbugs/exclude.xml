<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs baseline for spotbugsMain. Explain why each entry is accepted; anything not listed here fails the build.
  New entries should be narrow (pattern + class). The first entry is the exception: it is a global pattern
  exclusion.
-->
<FindBugsFilter>
    <!--
      Global: EI_EXPOSE_REP and EI_EXPOSE_REP2 are not reported for any class. Constructor-injected Spring beans
      (repositories, templates, registries) and records/DTOs that carry lists are stored by reference on purpose;
      copying them would break injection or cost allocations on the request path. At introduction this hid 46 of the
      49 findings (41 EI_EXPOSE_REP2 in constructors, 5 EI_EXPOSE_REP on record accessors). It is global rather than
      per package so that new beans and records in new packages do not each need an entry; it also hides any future
      finding of these two patterns.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!--
      Baseline at gate introduction: the constructor validates its Duration settings and throws on invalid
      configuration, which fails application startup as intended. The class is not subclassed.
    -->
    <Match>
        <Class name="com.laioffer.onlineorder.service.DeadLetterReplayService"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!--
      V7 builds ALTER TABLE / ALTER SEQUENCE statements for each id column. DDL takes no bind parameters for
      identifiers; the table and column names come from the migration's constant list and the sequence names from
      pg_get_serial_sequence, never from input.
    -->
    <Match>
        <Class name="db.migration.V7__Widen_keys_to_bigint"/>
        <Bug pattern="SQL_NONCONSTANT_STRING_PASSED_TO_EXECUTE"/>
    </Match>

    <!--
      V10 builds CREATE TABLE ... PARTITION OF, ALTER SEQUENCE, DROP CONSTRAINT/INDEX and a DISTINCT month query for
      each table it partitions. Identifiers cannot be bind parameters; the table and column names come from the
      migration's constant table list, the partition names from dates, and the constraint, index and sequence names
      from the PostgreSQL catalog, never from input.
    -->
    <Match>
        <Class name="db.migration.V10__Partition_append_only_tables"/>
        <Bug pattern="SQL_NONCONSTANT_STRING_PASSED_TO_EXECUTE"/>
    </Match>

    <!--
      V11 builds its LOCK TABLE, data checks, CREATE TABLE and ALTER TABLE statements from the migration's constant
      table, column, constraint and currency names; nothing comes from input.
    -->
    <Match>
        <Class name="db.migration.V11__Money_with_currency"/>
        <Bug pattern="SQL_NONCONSTANT_STRING_PASSED_TO_EXECUTE"/>
    </Match>

    <!--
      Baseline at gate introduction: defensive checks for a null KafkaTemplate#send result and a missing producer
      factory. The unit tests exercise both with mocks.
    -->
    <Match>
        <Or>
            <Class name="com.laioffer.onlineorder.messaging.OutboxEventPublisher"/>
            <Class name="com.laioffer.onlineorder.messaging.OutboxEventPublisher$BatchPublication"/>
        </Or>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/>
    </Match>
</FindBugsFilter>
